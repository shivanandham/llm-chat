# --------------------------------------------------------------------------
# Free LLM Chat Gateway — environment configuration
#
# Set the API key(s) for any providers you want active. You do NOT need all of
# them — even one works. The more you add, the more total free capacity you get
# and the longer the gateway can keep answering before everything is rate-limited.
#
# How to obtain each key: see docs/GET_API_KEYS.md
# Copy this file to `.env` and fill in what you have.
# --------------------------------------------------------------------------

# Google Gemini (Google AI Studio) — best quality on the free tier
GEMINI_API_KEY=

# Cerebras — fastest inference (~2000 tok/s)
CEREBRAS_API_KEY=

# Groq — very fast (~300+ tok/s)
GROQ_API_KEY=

# SambaNova — DeepSeek R1 + Llama on the free tier
SAMBANOVA_API_KEY=

# NVIDIA NIM (build.nvidia.com)
NVIDIA_API_KEY=

# Mistral (La Plateforme)
MISTRAL_API_KEY=

# OpenRouter — aggregator; many `:free` models behind one key
OPENROUTER_API_KEY=

# GitHub Models — use a GitHub fine-grained token with models:read
GITHUB_MODELS_TOKEN=

# Cohere
COHERE_API_KEY=

# Cloudflare Workers AI — needs BOTH the token and your account id
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --------------------------------------------------------------------------
# Gateway settings (all optional)
# --------------------------------------------------------------------------
# Require this key from clients (Authorization: Bearer <key> or x-api-key).
# Leave blank to run open (fine for localhost).
GATEWAY_API_KEY=
HOST=0.0.0.0
PORT=8000
# Seconds to rest a provider after a rate-limit with no Retry-After header.
LLM_DEFAULT_COOLDOWN=60
# Seconds to rest a provider after a transient/connection error.
LLM_TRANSIENT_COOLDOWN=15
# Per-attempt request timeout (seconds).
LLM_REQUEST_TIMEOUT=60
