# --------------------------------------------------------------------------
# Free LLM Chat Gateway — environment configuration
#
# Set the API key(s) for any providers you want active. You do NOT need all of
# them — even one works. The more you add, the more total free capacity you get
# and the longer the gateway can keep answering before everything is rate-limited.
#
# How to obtain each key: see docs/GET_API_KEYS.md
# Copy this file to `.env` and fill in what you have.
# --------------------------------------------------------------------------

# ===== Truly free: no credit card, no expiry (start with these) ===========

# Groq — very fast (~300+ tok/s). ~14,400 req/day. Permanent free.
GROQ_API_KEY=

# Cerebras — fastest inference (~2000 tok/s). ~1M tokens/day. Permanent free.
# (Free tier caps context at ~8k tokens.)
CEREBRAS_API_KEY=

# OpenRouter — many `:free` models behind one key. ~50 req/day (1,000 after a
# one-time $10 top-up). No card for the free models.
OPENROUTER_API_KEY=

# GitHub Models — a GitHub fine-grained token with Models:Read. Free per account.
GITHUB_MODELS_TOKEN=

# Cloudflare Workers AI — needs BOTH the token and your account id. ~10k neurons/day.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Mistral (La Plateforme) — ~1B tokens/month, but the free "Experiment" tier
# REQUIRES opting into data training.
MISTRAL_API_KEY=

# SambaNova — permanent low-RPM free tier (DeepSeek R1 + Llama). No card.
SAMBANOVA_API_KEY=

# ===== Trial / prepaid / restricted: NOT free-forever (optional) ===========

# Google Gemini (AI Studio) — NEW accounts now require PREPAID billing; Pro is
# paid. Only set this if you have an older free account or accept prepaid.
GEMINI_API_KEY=

# NVIDIA NIM (build.nvidia.com) — trial credits that EXPIRE (~30 days).
NVIDIA_API_KEY=

# Cohere — trial key (1,000 calls/mo) but NOT for production/commercial use.
COHERE_API_KEY=

# --------------------------------------------------------------------------
# Gateway settings (all optional)
# --------------------------------------------------------------------------
# Require this key from clients (Authorization: Bearer <key> or x-api-key).
# Leave blank to run open (fine for localhost).
GATEWAY_API_KEY=
HOST=0.0.0.0
PORT=8000
# Seconds to rest a provider after a rate-limit with no Retry-After header.
LLM_DEFAULT_COOLDOWN=60
# Seconds to rest a provider after a transient/connection error.
LLM_TRANSIENT_COOLDOWN=15
# Per-attempt request timeout (seconds).
LLM_REQUEST_TIMEOUT=60
